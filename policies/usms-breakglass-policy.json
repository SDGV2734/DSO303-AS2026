{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SuspendAndResumeEcsScalingOnlyLikeLab06",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:RegisterScalableTarget",
        "application-autoscaling:DescribeScalableTargets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "application-autoscaling:service-namespace": "ecs" }
      }
    }
  ]
}
